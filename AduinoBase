
#include <Arduino.h>
#include <DFRobotDFPlayerMini.h>

DFRobotDFPlayerMini player;

// Nano D5 connects to Audio Feather D6
#define TRANSFORM_INPUT 6

bool lastTransformSignal = false;

void setup() {
  Serial.begin(115200);
  delay(2000);

  pinMode(TRANSFORM_INPUT, INPUT_PULLDOWN);

  Serial.println("Starting Kat Audio Controller...");

  Serial1.begin(9600);

  if (!player.begin(Serial1, true, true)) {
    Serial.println("DFPlayer NOT detected!");
    while (true) {
      delay(1000);
    }
  }

  Serial.println("DFPlayer detected!");

  player.volume(30);
  delay(500);

  Serial.println("Ready for transformation trigger!");
}

void loop() {
  bool signal = digitalRead(TRANSFORM_INPUT);

  // Trigger only on a new HIGH pulse
  if (signal && !lastTransformSignal) {
    Serial.println("TRANSFORMATION AUDIO TRIGGERED!");

    player.playMp3Folder(1);
  }

  lastTransformSignal = signal;

  // Read DFPlayer messages
  if (player.available()) {
    uint8_t type = player.readType();
    int value = player.read();

    if (type == DFPlayerPlayFinished) {
      Serial.print("Transformation audio finished: ");
      Serial.println(value);
    }
  }

  delay(10);
}
